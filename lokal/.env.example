# Salin menjadi .env. Hanya untuk komputer pengembang; produksi memakai nilai lain (Phase 10).
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa-lokal
POSTGRES_DB=ruang_lega

# Garage. Buat nilai baru dengan:
#   GARAGE_RPC_SECRET:  openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN: openssl rand -base64 32
#   GARAGE_ACCESS_KEY:  "GK" diikuti 24 karakter heksadesimal (openssl rand -hex 12)
#   GARAGE_SECRET_KEY:  openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=localhost
