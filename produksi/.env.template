# Produksi. Salin menjadi .env di VPS (chmod 600). Jangan pernah di-commit.

# Image yang ditarik VPS (dibangun di luar VPS, docs/12-deployment.md)
BACKEND_IMAGE=ghcr.io/PEMILIK/ruang-lega-backend:TAG
STOREFRONT_IMAGE=ghcr.io/PEMILIK/ruang-lega-website:TAG

# PostgreSQL
POSTGRES_USER=ruanglega
POSTGRES_PASSWORD=
POSTGRES_DB=ruanglega
DATABASE_URL=postgres://ruanglega:ISI_PASSWORD@postgres:5432/ruanglega
REDIS_URL=redis://redis:6379

# Medusa
STORE_CORS=https://ruanglega.com
ADMIN_CORS=https://api.ruanglega.com
AUTH_CORS=https://ruanglega.com,https://api.ruanglega.com
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
MEDUSA_BACKEND_URL=https://api.ruanglega.com
STOREFRONT_URL=https://ruanglega.com
STOREFRONT_REVALIDATE_SECRET=
MEDUSA_PUBLISHABLE_KEY=

# File (Garage; kunci dibuat dengan `garage key create`)
S3_FILE_URL=https://media.ruanglega.com
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=media.ruanglega.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email, pembayaran, pengiriman (kosong = nonaktif)
RESEND_API_KEY=
EMAIL_FROM="Ruang Lega Studio <pesanan@ruanglega.com>"
OWNER_EMAIL=
STORE_WHATSAPP=6281214249759
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
BITESHIP_API_KEY=
BITESHIP_ORIGIN_POSTAL_CODE=

# Cadangan (scripts/backup.sh): kata sandi enkripsi dan remote rclone di luar VPS
BACKUP_PASSPHRASE=
BACKUP_REMOTE=cadangan:ruang-lega
BACKUP_KEEP_DAYS=14
